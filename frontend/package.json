    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.169.0",
    "autoprefixer": "10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.14",
