[Unit]
Description=LunaiCAD artifact retention sweep (docs/ops/data-retention.md)
After=network.target postgresql.service

[Service]
Type=oneshot
User=lunaicad
Group=lunaicad
WorkingDirectory=/opt/lunaicad/backend
EnvironmentFile=/opt/lunaicad/backend/.env
ExecStart=/opt/lunaicad/backend/.venv/bin/python -m app.ops.retention_sweep
