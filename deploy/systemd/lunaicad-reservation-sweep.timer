[Unit]
Description=Run lunaicad-reservation-sweep.service every 5 minutes (docs/operations/cost-control-architecture.md)

[Timer]
# Default COST_RESERVATION_TTL_SECONDS is 600s (10m); sweeping every 5m
# catches an orphaned reservation within one TTL window of it going stale.
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=15

[Install]
WantedBy=timers.target
