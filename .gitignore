# Python
# No trailing slash: backend/.venv is a symlink to ~/.venvs/lunaicad-backend
# on dev machines, not a real directory -- a trailing-slash pattern only
# matches directories and silently lets a symlink through as untracked.
backend/.venv
__pycache__/
*.pyc
backend/cadmaker.db
backend/cadmaker.db-shm
backend/cadmaker.db-wal
backend/storage_data/
backend/.env
backend/tmp/
.pytest_cache/

# Node / Next
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# OS / editor
.DS_Store
*.log
frontend/tsconfig.tsbuildinfo

# Generated debug artifacts (threaded-part cross-sections, etc.)
backend/reports/thread_debug/

# Generated drawing/CAD debug artifacts
backend/eval_reports/drawing_debug/

# Loose, uncurated one-off eval scratch runs (top-level eval_reports/ only --
# curated milestone snapshots live in eval_reports/baseline_phase*/ and stay
# tracked; see docs/release-change-inventory.md Step 3/18)
backend/eval_reports/generation_regression_mock_*.json
backend/eval_reports/semantic_benchmark_mock_*.json

# Local release-gate output (test/lint/build logs)
artifacts/
