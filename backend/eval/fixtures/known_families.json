    "case_id": "kf_hex_nut_001",
    "suite": "known_families",
    "workflow": "text_to_cad",
    "complexity": "moderate",
    "source": "probed against create_design (mock), 2026-07-26",
    "data_split": "regression",
    "prompt": "A hex nut, 18mm across flats, 10.8mm tall, M10 thread.",
    "expected_capability_classification": "generates",
    "expected_object_type": ["hex_nut"],
    "required_dimensions": {"x": 18.475, "y": 16, "z": 8.4},
    "allowed_assumptions": ["ISO 4032", "hex nut", "thread", "chamfer"],
    "geometric_assertions": {"units": "mm", "bbox_mm": {"x": 18.475, "y": 16, "z": 8.4}},
    "export_expectations": {"formats": ["stl", "step"], "require_reimport": true},
    "safety_classification": "safe",
    "notes": "The user's literal 18mm/10.8mm are NOT honored -- the standard-part honesty layer substitutes the real ISO 4032 M10 dims (16mm AF / 8.4mm tall) and discloses this in the assumption text ('Assumed ISO 4032... you can change standard'). This is intentional standards-adherence, not a silent-default bug; the eval case asserts the STANDARD's real dimensions, not the user's literal request, and this is exactly why the assertion is called out in this note rather than left implicit."
  },
