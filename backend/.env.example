# SourceCAD backend configuration — copy to `backend/.env` and edit.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  SECRETS POLICY                                                            │
# │  - NEVER commit `backend/.env` (it is gitignored).                        │
# │  - This file must contain PLACEHOLDERS ONLY — no real keys.               │
# │  - If a real OPENAI_API_KEY / JWT_SECRET was ever pasted into a tracked  │
# │    pasted into a tracked file, a shared machine, a chat, or a screen-      │
# │    share, treat it as COMPROMISED and ROTATE it immediately.              │
# │  - Run `bash scripts/check-secrets.sh` before committing.                 │
# └──────────────────────────────────────────────────────────────────────────┘

# Environment: development | staging | production
# In staging/production the app FAILS FAST unless the config below is safe.
APP_ENV=development

# Public URL the API is reachable at (used to build download links).
# In production this MUST be your real backend URL, not localhost.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated allowed CORS origins (your frontend).
# In production set this to your real frontend origin(s); localhost is rejected.
CORS_ORIGINS=http://localhost:3000

# Exposes provider/storage status on /health + /api/provider-status for the dev
# UI. MUST be false in production.
DEV_MODE=true

# --- Auth ---
# REQUIRED in production: a strong, unique secret (the dev default is rejected).
# Generate one with:  openssl rand -hex 32
JWT_SECRET=6a47ee95fa7d1cee5ac4e8a09115179272a3c546c05e5e046f9f66203c214e98
# JWT_EXPIRE_MINUTES=10080

# --- Rate limiting (per-process, in-memory) ---
# Off in dev/test, ON by default in staging/production. Set RATE_LIMIT_ENABLED
# explicitly to force on/off in any environment. Each limit is
# "<requests>/<window_seconds>", applied per authenticated user (else per IP).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH=10/60          # login + signup (per IP)
# RATE_LIMIT_CREATE=30/60        # design creation (CAD generation)
# RATE_LIMIT_REGENERATE=60/60    # deterministic parameter rebuilds
# RATE_LIMIT_MODIFY=30/60        # plain-English / localized / circle edits
# RATE_LIMIT_DRAWING=12/60       # drawing interpretation (vision, costly)
# RATE_LIMIT_PACKAGE=60/60       # exports, packages, drawing views
# RATE_LIMIT_POLL=600/60         # drawing-job polling (clients poll ~1/s)
# RATE_LIMIT_READ=300/60         # cheap authenticated reads + public catalogues
# RATE_LIMIT_DEFAULT=120/60      # fallback for any other category
#
# NOTE (multi-worker): counters are per-process and in-memory. With N uvicorn
# workers the effective limit is roughly N x the configured value, and a restart
# clears all counters. That is a deliberate trade-off for a dependency-free
# limiter; a strict global limit needs a shared store (Redis) — the
# rate_limit(category) call sites would not change.
#
# Reverse proxy: X-Forwarded-For is IGNORED unless TRUST_PROXY_HEADERS=true.
# Turn it on ONLY when a proxy in front of the app OVERWRITES that header
# (nginx `proxy_set_header X-Forwarded-For $remote_addr`, an AWS ALB, or
# Cloudflare). If the app is reachable directly, leaving this off is what stops
# a client forging a new address per request to reset its anonymous bucket.
# When enabled the LAST entry is used, because that is the hop the trusted proxy
# actually wrote.
# TRUST_PROXY_HEADERS=false

# --- Database ---
# Dev defaults to a local SQLite file. DATABASE_URL is REQUIRED in production.
# The Postgres driver (psycopg[binary]) ships in requirements.txt:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cadmaker
# SQLite (single box; persist the file on a durable volume):
# DATABASE_URL=sqlite:///./cadmaker.db

# --- Storage ---
# "local" (default) or "s3". Downloads always go through an owner-checked API route.
STORAGE_BACKEND=local
# STORAGE_DIR=./storage_data
# For S3 / S3-compatible (MinIO, Cloudflare R2, ...). S3_BUCKET is required for s3.
# S3_BUCKET=sourcecad-exports
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=            # leave blank for AWS; set for MinIO/R2
# S3_ACCESS_KEY_ID=...        # omit to use an instance role / IAM profile
# S3_SECRET_ACCESS_KEY=...
# S3_SIGNED_URL_TTL=3600

# --- LLM provider: "openai" (production) or "mock" (offline, default) ---
# Keep `mock` for offline dev/tests (no keys, no cost). mock is REJECTED in prod.
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# Use a model id your account can access. An invalid id is non-fatal (it degrades
# through a fallback chain), but set a valid one to avoid latency + 503s.
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=                 # for Azure / OpenAI-compatible endpoints
# OPENAI_REASONING_EFFORT=medium   # low|medium|high, for reasoning models only
# OpenAI reliability tuning:
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2

# --- Drawing -> CAD job pipeline ---
# Whole-job watchdog (async drawing jobs are failed cleanly past this):
# DRAWING_JOB_TIMEOUT_SECONDS=180
# Budget for ONLY the vision interpretation call chain; on timeout the job
# continues into the deterministic fallback instead of failing:
# DRAWING_PROVIDER_TIMEOUT_SECONDS=75
# One retry re-sends a compressed image, never the full original:
# DRAWING_PROVIDER_RETRIES=1
# Uploads are downscaled to this max side before the provider call and CV:
# DRAWING_MAX_IMAGE_SIDE=1600
# Deterministic best-effort generation (REVIEW-flagged) after provider failure:
# DRAWING_ENABLE_DETERMINISTIC_FALLBACK=true

# --- Job queue / worker (docs/adr/0001-job-queue-database-backed.md) ---
# The queue is this database, not Redis -- run `python -m app.worker` as a
# separate process (docs/deployment.md) to actually process jobs; without a
# worker running, jobs stay queued (except under TESTING=true, which runs
# them inline for tests/local convenience -- see app.worker.runner.run_inline).
# JOB_WORKER_CONCURRENCY=2
# JOB_MAX_QUEUE_DEPTH=50
# JOB_PER_USER_CONCURRENT_LIMIT=2
# JOB_HARD_TIMEOUT_SECONDS=150
# JOB_SIGKILL_GRACE_SECONDS=5
# JOB_MEMORY_LIMIT_MB=1536          # RLIMIT_AS; 0 disables; Linux-only (see runner.py)
# JOB_CPU_TIME_LIMIT_SECONDS=120    # RLIMIT_CPU
# JOB_STALE_HEARTBEAT_SECONDS=90
# JOB_HEARTBEAT_INTERVAL_SECONDS=10
# JOB_WORKER_MAX_JOBS_BEFORE_RECYCLE=200
# JOB_SYNC_WAIT_SECONDS=45           # how long POST /api/designs/create poll-waits
# JOB_TMP_ROOT=./job_tmp

# --- CAD feature-graph engine (plain-English -> CadPlan -> CadQuery) ---
# Primary generation engine. "feature_graph" (default) composes parametric
# primitives from the prompt; "legacy" uses the old template-first pipeline.
# CAD_ENGINE=feature_graph
# Planner provider/model. CAD_LLM_PROVIDER defaults to LLM_PROVIDER; the OpenAI
# planner uses CAD_LLM_MODEL with a graceful fallback chain.
# CAD_LLM_PROVIDER=openai
# CAD_LLM_MODEL=gpt-4.1

# --- Observability (docs/ops/observability.md) -----------------------------
LOG_LEVEL=INFO
# HMAC secret for pseudonymizing user/tenant ids in telemetry. Falls back to
# JWT_SECRET if unset -- set a DEDICATED value in production.
# TELEMETRY_HASH_SECRET=
# Bearer token gating /metrics and the detailed /ready body. REQUIRED
# (>=16 chars) in production -- generate with: openssl rand -hex 16
# OPS_API_TOKEN=
# Set this (to a writable, empty-on-boot directory) ONLY when running uvicorn
# with --workers > 1 (see deploy/systemd/lunaicad-backend.service, which
# handles creating/emptying it before each start). Leave unset for a single
# worker process (dev, or --workers 1) -- metrics work correctly either way,
# this only matters for correct AGGREGATION across multiple processes.
# PROMETHEUS_MULTIPROC_DIR=/opt/lunaicad/prometheus_multiproc

# --- Quotas, circuit breaker, retention (docs/ops/data-retention.md) -------
# QUOTA_DESIGNS_PER_DAY=200
# QUOTA_DESIGNS_PER_MONTH=2000
# STORAGE_QUOTA_MB_PER_USER=4096
# ARTIFACT_RETENTION_DAYS=180
# LLM_CIRCUIT_BREAKER_ENABLED=true
# LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
# LLM_COST_DAILY_CAP_USD=25.0

# --- DB connection pool (no-op for SQLite) ----------------------------------
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
